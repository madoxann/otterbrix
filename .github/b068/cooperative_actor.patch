+// B-068 (otterbrix debug branch, applied in CI only): every cooperative actor registers itself so a
+// stall dump can print its mailbox/behavior state, and resume_impl reports parking a busy actor.
+#define ACTOR_ZETA_B068_DEBUG 1
+
+namespace actor_zeta { namespace b068 {
+
+    struct entry_t final {
+        void* actor;
+        void (*write_state)(void*, std::FILE*);
+    };
+
+    struct registry_t final {
+        std::mutex mutex;
+        std::vector<entry_t> actors;
+    };
+
+    inline registry_t& registry() {
+        static auto* instance = new registry_t;
+        return *instance;
+    }
+
+    // Installed by the host to route events into its own timeline; loud events fall back to stderr.
+    inline void (*event_hook)(const char* what, void* actor, const char* type, bool loud) = nullptr;
+
+    inline void report(const char* what, void* actor, const char* type, bool loud) {
+        if (event_hook != nullptr) {
+            event_hook(what, actor, type, loud);
+        } else if (loud) {
+            std::fprintf(stderr, "[actor-zeta b068] %s actor=%p type=%s\n", what, actor, type);
+        }
+    }
+
+    inline void write_actor_states(std::FILE* out) {
+        auto& reg = registry();
+        std::lock_guard<std::mutex> guard(reg.mutex);
+        std::fprintf(out, "--- cooperative actors (%zu)\n", reg.actors.size());
+        for (const auto& entry : reg.actors) {
+            entry.write_state(entry.actor, out);
+        }
+    }
+
+}} // namespace actor_zeta::b068
